# VERDICT - paper trading only. There is no setting that enables real orders;
# setting LIVE_TRADING_ENABLED or ALLOW_REAL_ORDERS to true makes the app refuse to start.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./verdict.db
MARKET_DATA_MODE=demo          # demo | live  (never switches silently)
INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.01
DAILY_LOSS_LIMIT=0.03
MAX_OPEN_POSITIONS=10
MAX_STOCK_EXPOSURE=0.15
SLIPPAGE_BPS=5
# Only for MARKET_DATA_MODE=live (backend only, never commit real values)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
# AI agents: with a key, Prosecutor/Defender/Judge (and Strategist veto) run on Gemini; without one, rule-based agents run.
# Every trial records which backend each agent used. Output is validated; bad output falls back and is journaled.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: symbol-to-official-Angel-One-instrument-token map for WebSocket subscriptions.
# Obtain tokens from Angel One's official instrument master; do not guess them.
# Example format only (replace values with verified tokens):
# ANGELONE_INSTRUMENT_TOKENS={"RELIANCE":"2885","TCS":"11536"}
